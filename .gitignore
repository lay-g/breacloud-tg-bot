# 构建产物
/bin/

# 本地数据库（SQLite 及其 WAL/journal 附属文件）
*.db
*.db-wal
*.db-shm
*.db-journal

# 本地配置与密钥：service install 写入 XDG 目录，这里是防呆，避免手写副本被提交
/config.yaml
/config.local.yaml
local.yaml
.env
.env.*

# 测试与调试产物
*.test
coverage.out
coverage.html
__debug_bin*

# 编辑器与操作系统
.vscode/
.idea/
.DS_Store
*.swp
*~

# 过程性文档：不随仓库分发
# - docs/plans 是 ExecPlan（实施过程记录）
# - docs/platform-issues 含账号相关的原始 API 响应
/docs/plans/
/docs/platform-issues/
