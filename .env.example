# 复制成 .env 后填写，并 chmod 600。
#
#   cp .env.example .env && chmod 600 .env
#
# 这些值会以环境变量注入容器，不会写进镜像，也不会进版本库（.env 已被 git 忽略）。
# 变量名前缀 BREACLOUD_TG_BOT_ 与配置文件的层级一一对应，
# 例如 telegram.bot_token 就是 BREACLOUD_TG_BOT_TELEGRAM_BOT_TOKEN。

# @BotFather 创建的机器人 token，必填
BREACLOUD_TG_BOT_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# BreaCloud 后台创建的 API Token，必填。需要这些 scope：
#   client.svc.read.list / read.get / read.traffic / read.traffic_history
#   client.svc.read.tasks / power.action
BREACLOUD_TG_BOT_BREACLOUD_API_TOKEN=bll_...

# 首个白名单 chat id，可留空。
# 留空时未授权的会话发送 /start 会收到一条包含自己 chat id 的提示，照着做即可。
BREACLOUD_TG_BOT_TELEGRAM_OWNER_CHAT_ID=0

# 可选：并发请求上限与单请求超时
# BREACLOUD_TG_BOT_BREACLOUD_CONCURRENCY=5
# BREACLOUD_TG_BOT_BREACLOUD_TIMEOUT=20s

# docker-compose.yml 还会读取下面两个（它们不是应用配置）
# TZ=Asia/Shanghai
# LOG_LEVEL=info
